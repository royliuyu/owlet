# Copy to .env and fill in. Priority: environment variables > .env > config/local.yaml > config/default.yaml
# Nested fields use a double underscore, for example OWLET_LLM__MODEL maps to llm.model

# Access token. Required before opening phone access (Tailscale).
OWLET_AUTH_TOKEN=

# Mutable data root. Defaults to <repo>/data. Can point at another drive or ~/.owlet
# OWLET_DATA_DIR=D:/owlet-data

# Override when switching to a cloud model (local Ollama is the default)
# OWLET_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OWLET_LLM__API_KEY=sk-xxxxxxxx
# OWLET_LLM__MODEL=qwen-plus-latest
# OWLET_LLM__REASONING_EFFORT=

# Google sign-in (Calendar; the same account can add Mail later).
# Create a Web application client in Google Cloud and register these callbacks:
#   http://127.0.0.1:8000/api/v1/google/callback
#   http://localhost:8000/api/v1/google/callback
# When deploying to the cloud, also add https://<host>/api/v1/google/callback
# and put that origin in OWLET_GOOGLE__REDIRECT_ORIGINS.
# OWLET_GOOGLE__CLIENT_ID=
# OWLET_GOOGLE__CLIENT_SECRET=
# OWLET_GOOGLE__REDIRECT_ORIGINS=https://owlet.example.com
