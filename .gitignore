.import_linter_cache/

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Frontend ─────────────────────────────────────────
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# ── Editor / system ──────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
